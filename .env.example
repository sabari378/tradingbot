APP_ENV=development
NIRV_MODE=PAPER
DATABASE_URL=postgresql+psycopg://nirv:nirv@postgres:5432/nirv
REDIS_URL=redis://redis:6379/0
# Required for every operator or execution action. Generate a long random value.
API_KEY=replace-with-a-long-random-operator-key
DEFAULT_SYMBOL=XAUUSD
DEFAULT_RISK_PERCENT=0.25
MAX_RISK_PERCENT=0.5
MAX_DAILY_LOSS_PERCENT=2
MIN_RISK_REWARD=1.5
MAX_OPEN_TRADES=1
TRADINGJOURNEY_URL=
TRADINGJOURNEY_API_KEY=
# Ubuntu host: use the Windows gateway's private/tunnel address. Docker Desktop may use host.docker.internal.
MT5_GATEWAY_URL=http://127.0.0.1:8100
MT5_GATEWAY_SECRET=
DEMO_TRADING_ENABLED=false
VOICE_TRADING_ENABLED=false
NEWS_API_KEY=
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DATA_DIR=backend/data
PAPER_SESSION_DURATION_SECONDS=3600
DEMO_SESSION_DURATION_SECONDS=7200
